APP_NAME="TeamSpace API"
DATABASE_URL="postgresql+psycopg://teamspace:your-db-password@localhost:5432/teamspace"
JWT_SECRET_KEY="replace-with-your-openssl-rand-hex-output"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_BASE_URL="http://localhost:3000"
# Keep this key stable. If omitted, a derived key based on JWT_SECRET_KEY is used.
ANONYMOUS_AUTHOR_SECRET=

# Password-reset email (SMTP). Configure these to enable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Browser push (VAPID). Configure both keys to enable push delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@teamspace.local"

# Bank transaction lookup. Keep real account numbers, IDs, secrets, and tokens
# only in the server's local .env; never expose them to the frontend.
BANK_PROVIDER=
BANK_ACCOUNT_ALIAS=
BANK_ACCOUNT_NUMBER=
BANK_API_BASE_URL=
BANK_API_CLIENT_ID=
BANK_API_CLIENT_SECRET=
BANK_API_TOKEN=
